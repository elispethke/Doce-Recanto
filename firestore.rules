rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Allowlist do painel administrativo. Documentos são criados manualmente
    // pelo Console do Firebase (ou por um script com Admin SDK) — nunca pelo
    // client, para não permitir que um usuário se autopromova a admin.
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read, write: if isAdmin();
    }

    match /chats/{orderId} {
      match /messages/{messageId} {
        // TODO: quando o app do motorista existir, trocar por uma checagem
        // "isAdmin() || isAssignedDriver(orderId)" baseada em drivers/{uid}.
        allow read, write: if isAdmin();
      }

      match /typing/{participantId} {
        allow read, write: if isAdmin();
      }
    }

    match /drivers/{driverId} {
      allow read, write: if isAdmin();
    }

    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    match /products/{productId} {
      allow read, write: if isAdmin();
    }

    match /settings/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
